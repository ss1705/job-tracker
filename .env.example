# Optional: enables the LLM fallback for emails the rules can't parse (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Where the SQLite DB lives
DB_PATH=data/jobtracker_v3.db
# Gmail OAuth client (Desktop app) downloaded from Google Cloud Console
GMAIL_CLIENT_FILE=secrets/gmail_client.json
GMAIL_TOKEN_FILE=secrets/token.json
# Extra senders to ignore (comma-separated domains/addresses)
BLOCKED_SENDERS=
# Timezone for 'applied on' dates (default: this machine's)
TIMEZONE=
# Auto-sync Gmail every N minutes while the server runs (0 = off) and how many days back each run looks
AUTO_SYNC_MINUTES=120
AUTO_SYNC_LOOKBACK_DAYS=3
# Follow-up reminders: nudge after N days of silence, stop after MAX days; check in on OA/Interview after N days
FOLLOWUP_DAYS=14
FOLLOWUP_MAX_DAYS=30
CHECKIN_DAYS=7
